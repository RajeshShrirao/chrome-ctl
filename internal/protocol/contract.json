{
  "protocolVersion": "2.0",
  "capabilities": [
    "snapshot.diff",
    "scheduler.singleflight",
    "macro.saga",
    "humanizer.seed",
    "protocol.codegen"
  ],
  "methods": [
    { "name": "system.ready", "go": "MethodSystemReady", "ts": "systemReady" },
    { "name": "system.ping", "go": "MethodSystemPing", "ts": "systemPing" },
    { "name": "session.status", "go": "MethodSessionStatus", "ts": "sessionStatus" },
    { "name": "window.list", "go": "MethodWindowList", "ts": "windowList" },
    { "name": "window.create", "go": "MethodWindowCreate", "ts": "windowCreate" },
    { "name": "window.ensure", "go": "MethodWindowEnsure", "ts": "windowEnsure" },
    { "name": "window.use", "go": "MethodWindowUse", "ts": "windowUse" },
    { "name": "window.close", "go": "MethodWindowClose", "ts": "windowClose" },
    { "name": "tab.list", "go": "MethodTabList", "ts": "tabList" },
    { "name": "tab.open", "go": "MethodTabOpen", "ts": "tabOpen" },
    { "name": "tab.switch", "go": "MethodTabSwitch", "ts": "tabSwitch" },
    { "name": "page.snap", "go": "MethodPageSnap", "ts": "pageSnap" },
    { "name": "page.read", "go": "MethodPageRead", "ts": "pageRead" },
    { "name": "page.wait", "go": "MethodPageWait", "ts": "pageWait" },
    { "name": "page.eval", "go": "MethodPageEval", "ts": "pageEval" },
    { "name": "page.attr", "go": "MethodPageAttr", "ts": "pageAttr" },
    { "name": "page.net", "go": "MethodPageNet", "ts": "pageNet" },
    { "name": "page.formstate", "go": "MethodPageFormState", "ts": "pageFormState" },
    { "name": "action.click", "go": "MethodActionClick", "ts": "actionClick" },
    { "name": "action.type", "go": "MethodActionType", "ts": "actionType" },
    { "name": "action.press", "go": "MethodActionPress", "ts": "actionPress" },
    { "name": "action.scroll", "go": "MethodActionScroll", "ts": "actionScroll" },
    { "name": "action.upload", "go": "MethodActionUpload", "ts": "actionUpload" },
    { "name": "media.shot", "go": "MethodMediaShot", "ts": "mediaShot" },
    { "name": "media.rec_start", "go": "MethodMediaRecStart", "ts": "mediaRecStart" },
    { "name": "media.rec_stop", "go": "MethodMediaRecStop", "ts": "mediaRecStop" },
    { "name": "media.capture", "go": "MethodMediaCapture", "ts": "mediaCapture" },
    { "name": "auth.sso", "go": "MethodAuthSSO", "ts": "authSSO" },
    { "name": "page.describe", "go": "MethodPageDescribe", "ts": "pageDescribe" },
    { "name": "page.resolve", "go": "MethodPageResolve", "ts": "pageResolve" },
    { "name": "macro.start", "go": "MethodMacroStart", "ts": "macroStart", "daemonLocal": true },
    { "name": "macro.save", "go": "MethodMacroSave", "ts": "macroSave", "daemonLocal": true },
    { "name": "macro.list", "go": "MethodMacroList", "ts": "macroList", "daemonLocal": true },
    { "name": "macro.run", "go": "MethodMacroRun", "ts": "macroRun", "daemonLocal": true }
  ],
  "errors": [
    { "go": "ErrConnection", "ts": "connection", "code": -32000 },
    { "go": "ErrElementNotFound", "ts": "elementNotFound", "code": -32001 },
    { "go": "ErrElementNotInteractable", "ts": "elementNotInteractable", "code": -32002 },
    { "go": "ErrTabNotFound", "ts": "tabNotFound", "code": -32003 },
    { "go": "ErrDebuggerDetached", "ts": "debuggerDetached", "code": -32004 },
    { "go": "ErrSSOTimeout", "ts": "ssoTimeout", "code": -32005 },
    { "go": "ErrUnauthorized", "ts": "unauthorized", "code": -32006 },
    { "go": "ErrNavigationFailed", "ts": "navigationFailed", "code": -32007 },
    { "go": "ErrMacroStepFailed", "ts": "macroStepFailed", "code": -32008 },
    { "go": "ErrDispatchedUnconfirmed", "ts": "dispatchedUnconfirmed", "code": -32009 },
    { "go": "ErrSnapshotStale", "ts": "snapshotStale", "code": -32010 },
    { "go": "ErrFeatureDisabled", "ts": "featureDisabled", "code": -32011 },
    { "go": "ErrBusy", "ts": "busy", "code": -32012 },
    { "go": "ErrInvalidRequest", "ts": "invalidRequest", "code": -32600 },
    { "go": "ErrMethodNotFound", "ts": "methodNotFound", "code": -32601 },
    { "go": "ErrInternal", "ts": "internal", "code": -32603 }
  ],
  "timeouts": {
    "defaultMs": 10000,
    "groups": [
      { "go": "ActionTypeTimeout", "name": "actions can take minutes (humanized typing)", "ms": 300000, "methods": ["action.type"] },
      { "go": "ActionMediumTimeout", "name": "medium actions (click, scroll, upload)", "ms": 60000, "methods": ["action.click", "action.scroll", "action.upload"] },
      { "go": "ActionPressTimeout", "name": "single key press", "ms": 20000, "methods": ["action.press"] },
      { "go": "PageWaitTimeout", "name": "page wait polling", "ms": 45000, "methods": ["page.wait"] },
      { "go": "MediaCaptureTimeout", "name": "screenshot capture", "ms": 30000, "methods": ["media.capture"] },
      { "go": "PageDescribeTimeout", "name": "element descriptor", "ms": 5000, "methods": ["page.describe"] },
      { "go": "PageResolveTimeout", "name": "selector resolution", "ms": 20000, "methods": ["page.resolve"] },
      { "go": "PageEvalTimeout", "name": "script evaluation", "ms": 35000, "methods": ["page.eval"] },
      { "go": "AuthSSOTimeout", "name": "SSO flow", "ms": 60000, "methods": ["auth.sso"] },
      { "go": "WindowCreateTimeout", "name": "window creation", "ms": 30000, "methods": ["window.create", "window.ensure"] }
    ]
  }
}
